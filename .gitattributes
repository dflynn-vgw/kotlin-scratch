#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Set default line ending behavior, in case people don't have core.autocrlf set
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.kt text
*.kts text
*.java text
*.gradle text
*.gradle.kts text
*.properties text
*.xml text
*.json text
*.yml text
*.yaml text
*.md text
*.txt text
*.gitignore text
*.gitattributes text
README text
LICENSE text
CHANGELOG text

# Source files
# ============
*.kt text diff=kotlin
*.kts text diff=kotlin
*.java text diff=java
*.groovy text diff=java
*.scala text diff=java
*.js text
*.jsx text
*.ts text
*.tsx text
*.css text
*.scss text
*.less text
*.html text
*.htm text
*.sql text

# Configuration files
# ==================
*.properties text
*.conf text
*.config text
*.ini text
*.cfg text
*.toml text
*.env text
*.env.* text

# Documentation
# =============
*.md text
*.txt text
*.adoc text
*.tex text
*.rtf text

# Scripts
# =======
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
/gradlew text eol=lf
*.gradlew text eol=lf

# Serialisation
# =============
*.json text
*.xml text
*.yml text
*.yaml text
*.csv text

# Graphics
# ========
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.eps binary
*.bmp binary
*.tiff binary
*.webp binary

# Archives
# ========
*.7z binary
*.gz binary
*.tar binary
*.tgz binary
*.zip binary
*.jar binary
*.war binary
*.ear binary
*.sar binary
*.rar binary

# Fonts
# =====
*.ttf binary
*.eot binary
*.otf binary
*.woff binary
*.woff2 binary

# Executables
# ===========
*.exe binary
*.pyc binary
*.class binary
*.dll binary
*.so binary
*.dylib binary

# RC files (like .babelrc or .eslintrc)
# =====================================
*rc text

# Ignore files (like .npmignore or .gitignore)
# =============================================
*ignore text

# Prevent massive diffs when lockfiles change
# ============================================
package-lock.json binary
yarn.lock binary
gradle.lockfile binary

# Special handling for Gradle Wrapper
# ===================================
gradle/wrapper/gradle-wrapper.properties text
gradle/wrapper/gradle-wrapper.jar binary

# IDE specific files
# ==================
*.iml text
*.ipr text
*.iws text
.classpath text
.project text

